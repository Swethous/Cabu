# Frontend-only env (never commit real secrets)

# Browser-facing base URL
NEXT_PUBLIC_RAILS_API_BASE_URL=http://localhost:3000

# Server-side base URL used by Next.js route handlers
RAILS_API_BASE_URL=http://backend:3000

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=post-images

GOOGLE_OIDC_CLIENT_ID=your-google-client-id
GOOGLE_OIDC_CLIENT_SECRET=your-google-client-secret
# Optional: override callback if needed
# GOOGLE_OIDC_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
