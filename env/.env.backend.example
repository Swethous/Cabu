# Backend-only env (never commit real secrets)

POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=stock_community_db

POSTGRES_HOST=db
DATABASE_URL=postgres://postgres:password@db:5432/stock_community_db
REDIS_URL=redis://redis:6379/0

# Optional app env
REDIS_SIDEKIQ_URL=redis://redis:6379/0
GOOGLE_OIDC_CLIENT_ID=your-google-client-id
CONTACT_ADMIN_EMAIL=you@example.com
FRONTEND_APP_URL=http://localhost:3001
